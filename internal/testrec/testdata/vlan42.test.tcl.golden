# Code generated by Termwright from cases/vlan/vlan-42_up.yaml. DO NOT EDIT - change the YAML (or record it again) and save it.
source [file join [file dirname [file normalize [info script]]] .. .. lib tcl twtest.tcl]

tw::test {VLAN 42 is up} [list {vlan} {42}] {} {
    tw::step {show version} 0 {
        tw::run {Lab/sw1} {show version}
        tw::contains {ExtremeXOS}
        tw::check field {version (\S+)} equals {32.6.1.4}
        tw::save {ver} field {version (\S+)}
    }
    tw::step {show vlan {{vlan}}} 0 {
        tw::run {Lab/sw1} {show vlan {{vlan}}}
        tw::matches {v{{vlan}} created}
    }
    tw::step {GET /vlans} 0 {
        tw::http {/vlans} -session {APIs/sw1}
        tw::status 200
        tw::check json {data.items[0].tag} greater 40
        tw::check json {data.items.length} equals {2}
        tw::check json {data.items[-1].name} equals {v7}
        tw::check json {missing} missing
        tw::max_ms 5000
        tw::save {first} json {data.items[0].name}
    }
    tw::step {uses saved {{first}} and {{ver}}} 0 {
        tw::run {Lab/sw1} {show vlan {{vlan}}}
        tw::contains {{{first}}}
    }
}
tw::done
